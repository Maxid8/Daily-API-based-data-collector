# Alpha Vantage
API_KEY=your_alpha_vantage_api_key

# PostgreSQL
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name

# AWS: boto3 reads the three AWS_* variables from the environment.
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_DEFAULT_REGION=eu-north-1
S3_BUCKET_NAME=your_s3_bucket_name

# Optional. Only needed behind a TLS-inspecting corporate proxy: path to a PEM
# bundle that contains botocore's default CA list plus the proxy's CA certificates.
# AWS_CA_BUNDLE=C:\certs\aws-ca-bundle.pem
